import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Primary;
import java.util.HashMap;
import java.util.Map;

@Configuration
public class AutowireAndTypeConfig {

    @Bean
    public Warehouse warehouse() {
        Warehouse wh = new Warehouse();
        Map<String, Integer> limits = new HashMap<>();
        
        // Java handles type safety implicitly; Spring's ConversionService 
        // takes care of string-to-primitive/wrapper changes automatically
        limits.put("NorthHub", 5000); 
        limits.put("SouthHub", 2500);
        
        wh.setCapacityLimits(limits);
        return wh;
    }

    // Modern equivalent of byType/constructor autowiring is clean Constructor Injection.
    // The @Autowired annotation is completely optional when there is only a single constructor.
    @Bean
    public InventoryManager inventoryManager(Warehouse warehouse) {
        return new InventoryManager(warehouse);
    }
}



